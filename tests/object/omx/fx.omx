omx 1
# Shared particle library
# Particle systems are attached to models through "emitter" lines and started by
# animation events (ev <t> pfx <emitter name>) or automatically.

pfx 400 dust
    max 32
    mat 203
    burst 12
    rate 0
    dur 0.4
    life 0.3 0.6
    speed 0.2 0.6
    shape cone 70 0.05
    gravity 0 -0.5 0
    drag 2.0
    color 0.0  0.6 0.5 0.4 0.6
    color 1.0  0.6 0.5 0.4 0
    size 0.0 0.05
    size 1.0 0.25
end

pfx 401 torch_fire
    max 128
    mat 203
    rate 40
    loop
    local
    life 0.4 0.9
    speed 0.3 0.8
    spin -90 90
    shape sphere 0.04
    gravity 0 1.2 0
    flipbook 4 4 24
    color 0.0  1 0.9 0.5 1
    color 0.5  1 0.4 0.1 0.8
    color 1.0  0.2 0.2 0.2 0
    size 0.0 0.08
    size 1.0 0.02
end
